<div class="lock-picking-app {{#if (eq stage "puzzle")}}is-puzzle{{else}}is-instructions{{/if}}">
  {{#if (eq stage "instructions")}}
    <div class="lock-picking-instructions">
      <h2>{{localize "pf2e-customizations.lockPicking.instructionsTitle"}}</h2>
      <p>{{localize "pf2e-customizations.lockPicking.instructionsBody"}}</p>
      <p class="lock-picking-lock-info">{{localize "pf2e-customizations.lockPicking.pinCountLabel"}}: {{pinCount}} &mdash; DC {{dc}}</p>
      <div class="lock-picking-actions">
        <button type="button" data-action="cancelInstructions">{{localize "pf2e-customizations.lockPicking.instructionsCancel"}}</button>
        <button type="button" data-action="begin" class="default">{{localize "pf2e-customizations.lockPicking.begin"}}</button>
      </div>
    </div>
  {{else}}
    <div class="lock-picking-puzzle">
      <p class="lock-picking-header">{{actorName}} &mdash; DC {{dc}}</p>
      <p class="lock-picking-mistakes{{#if warningMistakes}} is-warning{{/if}}">
        {{localize "pf2e-customizations.lockPicking.mistakes"}}: {{mistakes}} / {{mistakeThreshold}}
      </p>
      <div class="lock-picking-pins">
        {{#each pins}}
          <div class="lock-picking-pin is-{{state}}{{#if mistake}} is-mistake{{/if}}">
            <div class="lock-picking-tension-label">{{localize "pf2e-customizations.lockPicking.tensionLabel"}}</div>
            <div class="lock-picking-tension"></div>
            <input type="range" min="0" max="100" value="50" {{disabled (ne state "active")}}>
          </div>
        {{/each}}
      </div>
      <div class="lock-picking-actions">
        <button type="button" data-action="giveUp">{{localize "pf2e-customizations.lockPicking.giveUp"}}</button>
        <button type="button" data-action="setPin" class="default">{{localize "pf2e-customizations.lockPicking.setPin"}}</button>
      </div>
    </div>
  {{/if}}
</div>
